rules_version = '2';
// Regole di sicurezza del database del gestionale iTeam.
// Da incollare in Firebase → Firestore Database → Regole → Pubblica.
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function owner() {
      return signed() && request.auth.token.email.lower() in ['carone.t46@gmail.com', 'segreteria.iteam@gmail.com']
        && request.auth.token.email_verified == true;
    }
    function hasProfile() { return signed() && exists(/databases/$(database)/documents/utenti/$(request.auth.uid)); }
    function prof() { return get(/databases/$(database)/documents/utenti/$(request.auth.uid)).data; }
    function active() { return owner() || (hasProfile() && prof().attivo == true); }
    function admin() { return owner() || (active() && prof().ruolo == 'admin'); }
    function office() { return admin() || (active() && prof().ruolo in ['ufficio', 'ufficio_tecnico']); }
    // Ufficio vero (Tommaso e Irene): amministratore e ruolo "ufficio", senza "ufficio_tecnico" e senza tecnici
    function ufficio() { return admin() || (active() && prof().ruolo == 'ufficio'); }

    // Utenti: ognuno si registra "in attesa", solo l'amministratore attiva e assegna i ruoli
    match /utenti/{uid} {
      allow read: if admin() || (signed() && request.auth.uid == uid);
      allow create: if admin() || (signed() && request.auth.uid == uid
        && request.resource.data.attivo == false && request.resource.data.ruolo == 'nuovo');
      allow update, delete: if admin();
    }
    // Impostazioni: tutti gli attivi leggono, solo ufficio e amministratore modificano
    match /config/{doc} {
      allow read: if active();
      allow write: if office();
    }
    // Contabilità (fatture dei fornitori e DDT): solo il titolare e chi ha la spunta "Contabilità" in 👤 Utenti
    function contab() { return owner() || (active() && prof().get('contabilita', false) == true); }
    match /crediti/{id} { allow read, write: if contab(); }
    match /contabilita/{id} {
      allow read, write: if contab();
    }
    // Fatture ai clienti, ordini ai fornitori e contratti: solo ufficio e amministratore (i tecnici non li vedono)
    match /fatture/{id} { allow read, write: if office(); }
    match /ordini/{id} { allow read, write: if office(); }
    match /contratti/{id} { allow read, write: if office(); }
    // F-gas: i tecnici registrano l'intervento dal rapportino ma non lo vedono; detrazioni solo ufficio vero
    match /fgasOps/{id} { allow create: if active(); allow read, update, delete: if ufficio(); }
    match /detrazioni/{id} { allow read, write: if ufficio(); }
    // furgoni, attrezzature e loro documenti: solo ufficio vero
    match /mezzi/{id} { allow read, write: if ufficio(); }
    match /attrezzature/{id} { allow read, write: if ufficio(); }
    // Ore libere (altri lavori senza cliente, ferie, permessi, malattia): l'ufficio vede e gestisce tutto;
    // il tecnico segna e modifica le sue (create da lui o a suo nome), non le cancella e non vede quelle degli altri
    function mieOre(d) { return d.uid == request.auth.uid || (hasProfile() && d.tecnico == prof().get('tecnico', '')); }
    match /oreLibere/{id} {
      allow read: if office() || (active() && mieOre(resource.data));
      allow create: if office() || (active() && request.resource.data.uid == request.auth.uid);
      allow update: if office() || (active() && mieOre(resource.data) && request.resource.data.uid == resource.data.uid);
      allow delete: if office();
    }
    // Trasferimento dal calendario dell'iPhone: solo il titolare
    match /calendariFeed/{id} { allow read, write: if owner(); }
    match /eventiCal/{id} { allow read, write: if owner(); }
    // Ruoli
    function ruolo() { return owner() ? 'admin' : prof().ruolo; }
    function preventivatore() { return active() && ruolo() in ['preventivatore', 'tecnico_preventivatore']; }
    // Registro delle modifiche: ognuno aggiunge, nessuno cambia o cancella; lo legge l'ufficio
    match /registro/{id} {
      allow create: if active() && request.resource.data.chi is string;
      allow read: if office();
      allow update, delete: if false;
    }
    // Cestino: copia di ciò che viene eliminato (elimina solo l'ufficio); ripristina l'ufficio, svuota l'amministratore
    match /cestino/{id} {
      allow create: if office() || contab();
      allow read, delete: if office();
      allow update: if false;
    }
    // Preventivi: li fanno ufficio e preventivatori; i tecnici non li vedono
    match /preventivi/{id} {
      allow read, create, update: if office() || preventivatore();
      allow delete: if office();
    }
    // Listino con prezzi d'acquisto e ricarichi: lo cambia solo l'ufficio, lo leggono ufficio e preventivatori
    match /listino/{id} {
      allow read: if office() || preventivatore();
      allow write: if office();
    }
    // Prezzi d'acquisto del magazzino: solo ufficio e preventivatori (i tecnici vedono quantità e prezzo di vendita)
    match /magazzinoPrezzi/{id} { allow read, write: if office() || preventivatore(); }
    // Parti riservate delle commesse (descrizione interna e documenti non condivisi): solo ufficio
    match /commesseRiservate/{id} { allow read, write: if office(); }
    // Rubrica clienti: Tommaso e Irene vedono tutto, gli altri solo i clienti con attività nell'ultimo anno
    match /clienti/{id} {
      allow read: if ufficio() || (active() && resource.data.get('recente', false) == true);
      allow create, update: if active();
      allow delete: if office();
    }
    // Code di servizio (telefono→PC, notifiche, promemoria): chi le usa può anche toglierle
    match /scansioni/{id} { allow read, write: if active(); }
    match /dispositivi/{id} { allow read, write: if active(); }
    match /promemoriaClienti/{id} { allow read, write: if active(); }
    // Tutti gli altri dati (clienti, impianti, interventi, magazzino, dico, commesse, …):
    // gli attivi leggono, creano e modificano; ELIMINA solo l'ufficio (va nel cestino)
    match /{col}/{id} {
      allow read, create, update: if active() && !(col in ['utenti', 'config', 'contabilita', 'crediti', 'fatture', 'ordini', 'contratti', 'fgasOps', 'detrazioni', 'mezzi', 'attrezzature', 'oreLibere', 'calendariFeed', 'eventiCal', 'registro', 'cestino', 'preventivi', 'listino', 'magazzinoPrezzi', 'commesseRiservate', 'clienti']);
      allow delete: if office() && !(col in ['utenti', 'config', 'contabilita', 'crediti', 'fatture', 'ordini', 'contratti', 'fgasOps', 'detrazioni', 'mezzi', 'attrezzature', 'oreLibere', 'calendariFeed', 'eventiCal', 'registro', 'cestino', 'preventivi', 'listino', 'magazzinoPrezzi', 'commesseRiservate', 'clienti']);
    }
  }
}
