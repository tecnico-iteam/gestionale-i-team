rules_version = '2';
// Regole per foto e video dei rapportini e del magazzino.
// Da incollare in Firebase → Storage → Regole → Pubblica.
service firebase.storage {
  match /b/{bucket}/o {
    function active() {
      return request.auth != null && (
        (request.auth.token.email.lower() == 'carone.t46@gmail.com' && request.auth.token.email_verified == true)
        || firestore.get(/databases/(default)/documents/utenti/$(request.auth.uid)).data.attivo == true);
    }
    match /media/{file} {
      allow read, delete: if active();
      allow create: if active() && request.resource.size < 50 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
    }
  }
}
